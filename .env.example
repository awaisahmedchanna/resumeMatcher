# Comma-separated list of AI providers to try, in priority order.
# Valid values: openrouter, groq, gemini
AI_PROVIDER_ORDER=openrouter,groq,gemini

# Groq (OpenAI-compatible)
GROQ_API_KEY=your-groq-api-key
# Free/open models available on Groq as of 2026: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Google Gemini (gemini-1.5-flash is retired; use a current model)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

LLM_TIMEOUT_MS=180000
# Max output tokens per LLM call. Defaults: openrouter 16384, gemini 32768, groq 3000
# (Groq's free tier shares one 8000-TPM budget between input and output, so a large
# output budget makes every Groq request get rejected with 413). Override globally
# with LLM_MAX_OUTPUT_TOKENS or per provider, e.g.:
# LLM_MAX_OUTPUT_TOKENS_OPENROUTER=16384
# LLM_MAX_OUTPUT_TOKENS_GEMINI=32768
# LLM_MAX_OUTPUT_TOKENS_GROQ=3000

# Free-tier providers (e.g. Groq) cap ~8000 tokens per minute, so the resume and
# job description are truncated to keep a single request under the limit.
MAX_RESUME_CHARS=12000
MAX_JOB_DESC_CHARS=8000

MAX_UPLOAD_MB=5
