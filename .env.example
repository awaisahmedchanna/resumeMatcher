# Comma-separated list of AI providers to try, in priority order.
# Valid values: openrouter, groq, gemini
AI_PROVIDER_ORDER=openrouter,groq,gemini

# Groq (OpenAI-compatible)
GROQ_API_KEY=your-groq-api-key
# Free/open models available on Groq as of 2026: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Google Gemini (gemini-1.5-flash is retired; use a current model)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

LLM_TIMEOUT_MS=180000
MAX_UPLOAD_MB=5
